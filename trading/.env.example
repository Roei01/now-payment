# ---- required
DATABASE_URL=postgres://user:pass@localhost:5432/trading
APP_SECRET=                      # 32+ random chars (encrypts 2FA secrets, signs sessions)
SETUP_TOKEN=                     # one-time token to create the owner account in the UI
PORT=3000

# ---- market data (Alpaca). Without keys: MARKET_DATA_PROVIDER=simulated (dev only, never promotable)
MARKET_DATA_PROVIDER=simulated
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
ALPACA_DATA_FEED=iex
MAX_QUOTE_AGE_MINUTES=20

# ---- USD/ILS rate: frankfurter (ECB reference, no key) or static (dev)
FX_PROVIDER=static
FX_STATIC_USD_ILS=3.7

# ---- fundamentals for the AI strategy (SEC EDGAR asks for "Name email" as User-Agent)
SEC_EDGAR_USER_AGENT=

# ---- AI investment manager (Anthropic). Without a key AI decisions are deferred (HOLD).
AI_PROVIDER=none
AI_API_KEY=
AI_MANAGER_MODEL=claude-opus-5
AI_MONTHLY_BUDGET_ILS=60
OPS_MONTHLY_CAP_ILS=150
INFRA_MONTHLY_ESTIMATE_ILS=0

# ---- brokers (names only in the DB; values only here)
BROKER_PAPER_KEY=
BROKER_PAPER_SECRET=
BROKER_LIVE_KEY=
BROKER_LIVE_SECRET=
LIVE_TRADING_ENABLED=false

# ---- e-mail alerts (Resend)
NOTIFICATIONS_PROVIDER=log
NOTIFICATIONS_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
DIGEST_HOUR_IL=23

# ---- worker cadence
WORKER_TICK_SECONDS=60
CYCLE_INTERVAL_MINUTES=60

# ---- demo only: allow simulated prices/static FX when NODE_ENV=production
ALLOW_SIMULATED_DATA=false
